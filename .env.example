# =============================================================================
# Center for Admission and Travels - Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# Database (required)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Base URL (required for emails, links, sitemap)
# Use your production URL in production, e.g. https://example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics (optional - get ID from https://analytics.google.com)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack (payments)
# Get keys from https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYMENT_CURRENCY=GHS

# Email (for forgot password, welcome emails, etc.)
# Gmail: enable 2FA, create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=info@yourdomain.com

# Distributed rate limiting (recommended for production / multi-instance)
# Create at https://upstash.com (Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional tuning:
# RATE_LIMIT_PREFIX=rl
# RATE_LIMIT_FAIL_CLOSED=false

# Controlled seeding guards (keep false/empty in production by default)
# Use only for intentional one-off seed operations.
ALLOW_DATABASE_SEED=false
ALLOW_PRODUCTION_SEED=false
